# Copier ce fichier en .env (en local) ou ajouter ces variables dans Vercel
# Projet > Settings > Environment Variables. Ne JAMAIS publier la vraie clé.
GEMINI_API_KEY=votre_cle_ici
# Optionnel : modèle Gemini utilisé (par défaut gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Formulaire de contact (service Resend : https://resend.com)
RESEND_API_KEY=votre_cle_resend_ici
# Adresse qui reçoit les messages (celle de votre compte Resend)
CONTACT_EMAIL=votre_adresse@exemple.com
